# Supabase → Project Settings → Database → Connection string
# Pooled connection (Transaction pooler, port 6543) — used by the running site on Vercel
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by `prisma db push`
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Your public site address (no trailing slash). Used for checkout return URLs, update links and metadata.
NEXTAUTH_URL="https://bizziplugins.co.uk"

# Password for /admin (issue free licences). At least 8 characters.
ADMIN_PASSWORD="choose-a-long-password"

# Two-factor sign-in for /admin: a 6-digit code is emailed after the password.
# Use the SMTP details from your email provider for the mailbox that sends the code.
ADMIN_2FA_EMAIL="ian@bizziplugins.co.uk"
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT="465"
SMTP_USER="noreply@bizziplugins.co.uk"
SMTP_PASS="your-mailbox-or-app-password"
SMTP_FROM="Bizzi Plugins <noreply@bizziplugins.co.uk>"
